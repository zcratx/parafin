# Parafin sandbox credentials. Copy this file to .env, then fill in the values.
# Keep credentials server-side only.
PARAFIN_CLIENT_ID="<your-capital-client-id>"
PARAFIN_CLIENT_SECRET="<your-capital-client-secret>"

# Four sandbox people, each linked to a business in the named state.
PARAFIN_NO_OFFER_PERSON_ID="person_xxx"
PARAFIN_PREAPPROVED_PERSON_ID="person_xxx"
PARAFIN_ON_ITS_WAY_PERSON_ID="person_xxx"
PARAFIN_OUTSTANDING_PERSON_ID="person_xxx"
