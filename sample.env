# ============================================================
# Parafin Demo — Environment Variables
# ============================================================
# Copy this file to .env and fill in your sandbox credentials.
#   cp sample.env .env
#
# Credentials can be found in the Parafin Dashboard:
#   https://dashboard.parafin.com/settings/api-keys
# ============================================================

# ------------------------------------------------------------
# Capital
# Used by: Capital widget (ParafinWidget product="capital")
# ------------------------------------------------------------
PARAFIN_CLIENT_ID="<your-capital-client-id>"
PARAFIN_CLIENT_SECRET="<your-capital-client-secret>"

# ------------------------------------------------------------
# Pay Over Time (Line of Credit / BNPL)
# Used by: Pay Over Time widget and Order Checkout flow
# ------------------------------------------------------------
BNPL_CLIENT_ID="<your-bnpl-client-id>"
BNPL_CLIENT_SECRET="<your-bnpl-client-secret>"
